QWidget { color: #243447; font-size: 10pt; }
QMainWindow, QMainWindow > QWidget { background: #f3f6f8; }
QLabel { background: transparent; }
QFrame#sidebar {
    background: qlineargradient(x1:0, y1:0, x2:0.6, y2:1, stop:0 #152b3c, stop:1 #0d1d2b);
    border: none;
}
QLabel#brand { color: #ffffff; font-size: 23pt; font-weight: 700; }
QLabel#sidebarSubtitle { color: #a3bacb; font-size: 9pt; }
QPushButton#navButton {
    background: transparent; color: #b6c9d6; text-align: left;
    border: 1px solid transparent; border-radius: 9px; padding: 10px 14px;
}
QPushButton#navButton:hover { background: #233d4d; color: #ffffff; }
QPushButton#navButton:checked { background: #24515a; color: #e0fff7; border-color: #366873; }
QPushButton#navButton:focus { border-color: #76d4c0; }
QLabel#pageTitle { color: #192e3e; font-size: 21pt; font-weight: 700; }
QLabel#sectionTitle { color: #263f4f; font-size: 10pt; font-weight: 600; }
QLabel#muted, QLabel#footer, QLabel#previewStatus { color: #586c7e; font-size: 9pt; }
QLabel#fieldLabel { color: #566b7d; font-size: 9pt; }
QLabel#statusBadge {
    background: #e8eef3; color: #506477; padding: 8px 14px;
    border: 1px solid #dbe4ec; border-radius: 16px; font-size: 9pt; font-weight: 600;
}
QLabel#statusBadge[state="connected"] { background: #e2f4ee; color: #17624f; border-color: #bddfd2; }
QLabel#statusBadge[state="waiting"] { background: #fff3db; color: #795915; border-color: #eeddb4; }
QLabel#statusBadge[state="error"] { background: #fce9e7; color: #a13731; border-color: #efcdc8; }
QLabel#memberCount { font-size: 10pt; font-weight: 600; color: #177461; }
QLabel#localName { font-weight: 600; }
QFrame#card { background: #ffffff; border: 1px solid #dce5eb; border-radius: 12px; }
QFrame[frameShape="4"] { color: #e4ebef; max-height: 1px; }
QScrollArea#sessionPanel, QScrollArea#sessionPanel > QWidget > QWidget { background: #ffffff; }
QScrollArea { background: transparent; }
QFrame#stageHeader { background: #172f40; border: none; border-top-left-radius: 12px; border-top-right-radius: 12px; }
QLabel#stageTitle { color: #d8e8ef; font-size: 9pt; font-weight: 600; }
QLineEdit, QComboBox {
    background: #f8fafb; border: 1px solid #d8e2e9; border-radius: 7px;
    min-height: 20px; padding: 8px 10px; selection-background-color: #187d69; selection-color: #ffffff;
}
QLineEdit:hover, QComboBox:hover { border-color: #9bbaaf; }
QLineEdit:focus, QComboBox:focus { border: 1px solid #187d69; background: #ffffff; }
QLineEdit:disabled, QComboBox:disabled { background: #f0f4f6; color: #6a7d8d; border-color: #e1e8ed; }
QComboBox { padding-right: 28px; }
QComboBox::drop-down { width: 24px; border: none; }
QComboBox QAbstractItemView { background: #ffffff; border: 1px solid #d8e2e9; selection-background-color: #e2f4ee; selection-color: #17624f; padding: 4px; }
QPushButton { background: #ffffff; border: 1px solid #cfdae2; border-radius: 7px; padding: 9px 12px; }
QPushButton:hover { background: #edf7f3; border-color: #8cb6a8; }
QPushButton:pressed { background: #dceee7; border-color: #187d69; }
QPushButton:focus { border: 1px solid #187d69; }
QPushButton:disabled { background: #f2f5f7; color: #778896; border-color: #e1e8ed; }
QPushButton#primaryButton, QPushButton#allowControlButton { background: #187d69; color: #ffffff; border: 1px solid #187d69; font-weight: 600; }
QPushButton#primaryButton:hover, QPushButton#allowControlButton:hover { background: #126957; border-color: #126957; }
QPushButton#primaryButton:pressed, QPushButton#allowControlButton:pressed { background: #105744; }
QPushButton#primaryButton:focus, QPushButton#allowControlButton:focus { border: 1px solid #083e32; }
QPushButton#shareButton:enabled, QPushButton#controlButton:enabled { background: #edf7f3; color: #17624f; border-color: #aacfc1; font-weight: 600; }
QPushButton#shareButton:hover, QPushButton#controlButton:hover { background: #dceee7; }
QPushButton#stopControlButton:enabled { background: #fff2ef; color: #a13731; border-color: #e7c0ba; }
QPushButton#stopControlButton:hover { background: #fce3df; }
QPushButton#expandVideoButton { background: #25485a; color: #e2eff4; border: 1px solid #456273; padding: 5px 12px; font-size: 9pt; }
QPushButton#expandVideoButton:hover { background: #365f70; }
QPushButton#expandVideoButton:focus { border-color: #76d4c0; }
QPlainTextEdit { background: #ffffff; border: 1px solid #dce5eb; border-radius: 10px; padding: 14px; font-family: Consolas, monospace; font-size: 9pt; selection-background-color: #187d69; selection-color: #ffffff; }
QScrollBar:vertical { background: #f0f4f6; width: 8px; margin: 2px 0; border-radius: 4px; }
QScrollBar::handle:vertical { background: #becdd6; min-height: 30px; border-radius: 4px; }
QScrollBar::handle:vertical:hover { background: #93aab7; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QToolTip { color: #ffffff; background: #203e4c; border: 1px solid #456273; padding: 6px 10px; }
