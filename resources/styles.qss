QWidget { color: #28384b; font-size: 10pt; }
QMainWindow, QMainWindow > QWidget { background: #f3f5f8; }
QLabel { background: transparent; }
QFrame#sidebar {
    background: qlineargradient(x1:0, y1:0, x2:0.5, y2:1, stop:0 #172535, stop:1 #0e1927);
    border: none;
}
QLabel#brandMark { background: transparent; border: none; }
QLabel#brand { color: #f4f8fc; font-size: 20pt; font-weight: 700; }
QLabel#sidebarSubtitle { color: #8fa4b8; font-size: 9pt; padding-left: 3px; }
QLabel#navCaption { color: #688297; font-size: 8pt; font-weight: 600; padding-left: 8px; }
QPushButton#navButton {
    background: transparent; color: #a5b9cb; text-align: left;
    border: 1px solid transparent; border-radius: 9px; padding: 10px 12px;
}
QPushButton#navButton:hover { background: #20374a; color: #ffffff; }
QPushButton#navButton:checked { background: #23474b; color: #e4fff5; border-color: #345c5d; font-weight: 600; }
QPushButton#navButton:focus { border-color: #74cdbb; }
QPushButton#settingsButton { background: transparent; color: #b9d3d5; border: 1px solid transparent; padding: 8px 10px; }
QPushButton#settingsButton:hover { background: #20374a; border-color: #345c5d; }
QPushButton#settingsButton:focus { border-color: #74cdbb; }
QLabel#profileAvatar { background: #d9efeb; color: #237c77; border: 1px solid #baddd5; border-radius: 20px; font-size: 15pt; font-weight: 600; }
QLineEdit#meetingDisplayName { background: transparent; border-color: transparent; padding: 6px 2px; font-weight: 600; }
QLineEdit#meetingDisplayName:hover { border-color: #dce4ed; }
QLineEdit#meetingDisplayName:focus { background: #ffffff; border-color: #247e70; }
QLineEdit#meetingDisplayName:disabled { color: #34495d; background: transparent; border-color: transparent; }
QLabel#eyebrow { color: #6d8992; font-size: 8pt; font-weight: 600; }
QLabel#pageTitle { color: #1b2c40; font-size: 22pt; font-weight: 700; }
QLabel#sectionTitle { color: #263c50; font-size: 10pt; font-weight: 600; }
QLabel#localRemoteCode { font-size: 24pt; }
QLabel#muted, QLabel#footer, QLabel#previewStatus { color: #6b7c8e; font-size: 9pt; }
QLabel#fieldLabel { color: #718093; font-size: 9pt; }
QLabel#statusBadge {
    background: #e9edf3; color: #627589; padding: 8px 14px;
    border: 1px solid #dce3eb; border-radius: 16px; font-size: 9pt; font-weight: 600;
}
QLabel#statusBadge[state="connected"] { background: #e5f3ee; color: #24755f; border-color: #c6e3d8; }
QLabel#statusBadge[state="waiting"] { background: #fcf2df; color: #8b692d; border-color: #eedebc; }
QLabel#statusBadge[state="error"] { background: #fcecea; color: #ad504b; border-color: #f1d2cd; }
QLabel#memberCount { font-size: 9pt; font-weight: 600; color: #247866; }
QLabel#localName, QLabel#peerName { color: #2c4156; font-weight: 600; }
QLabel#shareStatus, QLabel#conferenceStatus { color: #63778a; font-size: 9pt; }
QLabel#notice { background: #f2f6f8; color: #6b7f8e; border: 1px solid #e5ebf0; border-radius: 8px; padding: 10px; font-size: 9pt; }
QFrame#card { background: #ffffff; border: 1px solid #e0e6ed; border-radius: 12px; }
QFrame[frameShape="4"] { color: #e7ecf1; max-height: 1px; }
QScrollArea#sessionPanel, QScrollArea#sessionPanel > QWidget > QWidget { background: #ffffff; }
QScrollArea { background: transparent; }
QFrame#stageHeader { background: #172a3b; border: none; border-top-left-radius: 12px; border-top-right-radius: 12px; }
QLabel#stageTitle { color: #dbe8f0; font-size: 9pt; font-weight: 600; }
QLabel#stageMeta { color: #7d9aa9; font-size: 8pt; padding-right: 8px; }
QLineEdit, QComboBox {
    background: #f7f9fc; border: 1px solid #dce4ed; border-radius: 8px;
    min-height: 20px; padding: 8px 10px; selection-background-color: #247e70; selection-color: #ffffff;
}
QLineEdit:hover, QComboBox:hover { border-color: #a6bfb9; }
QLineEdit:focus, QComboBox:focus { border: 1px solid #247e70; background: #ffffff; }
QLineEdit:disabled, QComboBox:disabled { background: #f1f4f8; color: #8492a1; border-color: #e4e9ef; }
QComboBox { padding-right: 28px; }
/* 没有可用设备时，下拉框只剩灰色占位提示“无可用设备”。 */
QComboBox[noDevice="true"] { color: #8492a1; }
QComboBox::drop-down { width: 24px; border: none; }
QComboBox#recentRemoteCodes { padding-right: 10px; }
QComboBox#recentRemoteCodes::drop-down { width: 0px; }
QComboBox#recentRemoteCodes QLineEdit { border: none; background: transparent; padding: 0px; }
QComboBox QAbstractItemView { background: #ffffff; border: 1px solid #dce4ed; selection-background-color: #e5f3ee; selection-color: #24755f; padding: 6px; }
QPushButton { background: #ffffff; border: 1px solid #d8e1ea; border-radius: 8px; padding: 9px 12px; }
QPushButton:hover { background: #f0f7f5; border-color: #9ebeb3; }
QPushButton:pressed { background: #e0efe9; border-color: #247e70; }
QPushButton:checked { background: #e5f3ee; color: #24755f; border-color: #a8cec1; }
QPushButton:focus { border: 1px solid #247e70; }
QPushButton:disabled { background: #f3f5f8; color: #8795a5; border-color: #e4e9ef; }
QPushButton#primaryButton:enabled, QPushButton#allowControlButton:enabled, QPushButton[role="primary"]:enabled { background: #247e70; color: #ffffff; border-color: #247e70; font-weight: 600; }
QPushButton#primaryButton:hover, QPushButton#allowControlButton:hover, QPushButton[role="primary"]:hover { background: #1d6d60; border-color: #1d6d60; }
QPushButton#primaryButton:pressed, QPushButton#allowControlButton:pressed, QPushButton[role="primary"]:pressed { background: #195b51; }
QPushButton#primaryButton:focus, QPushButton#allowControlButton:focus, QPushButton[role="primary"]:focus { border-color: #12483f; }
QPushButton#shareButton:enabled, QPushButton#controlButton:enabled { background: #edf6f2; color: #24755f; border-color: #c2ddd2; font-weight: 600; }
QPushButton#shareButton:hover, QPushButton#controlButton:hover { background: #dfeee7; }
QPushButton#stopControlButton:enabled, QPushButton[role="danger"]:enabled { background: #fcf0ee; color: #ad504b; border-color: #ebd1ca; }
QPushButton#stopControlButton:hover, QPushButton[role="danger"]:hover { background: #f9e3df; }
QPushButton#expandVideoButton { background: #263e50; color: #dcebf3; border: 1px solid #3b566a; padding: 5px 12px; font-size: 9pt; }
QPushButton#expandVideoButton:hover { background: #34536a; }
QPushButton#expandVideoButton:focus { border-color: #74cdbb; }
QPlainTextEdit { background: #ffffff; border: 1px solid #e0e6ed; border-radius: 12px; padding: 16px; font-family: Consolas, monospace; font-size: 9pt; selection-background-color: #247e70; selection-color: #ffffff; }
QScrollBar:vertical { background: #f2f5f8; width: 7px; margin: 3px 0; border-radius: 3px; }
QScrollBar::handle:vertical { background: #c9d4de; min-height: 30px; border-radius: 3px; }
QScrollBar::handle:vertical:hover { background: #9fb2c1; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QToolTip { color: #edf5fa; background: #233a4e; border: 1px solid #415c70; padding: 7px 10px; }

/* Meeting workspace: shared content, participant rail, and a compact roster. */
QFrame#meetingStage, QFrame#meetingParticipants, QFrame#meetingFooter {
    background: #ffffff; border: 1px solid #d9e3eb; border-radius: 12px;
}
QPushButton[meetingToggle="true"] {
    border: 1px solid #359a92; border-radius: 16px; color: #237c77;
    background: #f4fbfa; padding: 9px 12px; font-weight: 600;
}
QPushButton[meetingToggle="true"]:hover { background: #e2f4f0; }
QPushButton[meetingToggle="true"]:checked {
    background: #f4f0ef; border-color: #c9a8a2; color: #a45c53;
}
QPushButton[meetingToggle="true"]:disabled { background: #f4f7f9; color: #8795a5; border-color: #dbe3ea; }
QLabel#memberAvatar {
    background: #d9efeb; color: #237c77; border: 1px solid #baddd5;
    border-radius: 20px; font-size: 15pt; font-weight: 600;
}
QLabel#memberName { color: #34495d; font-size: 9pt; }
QPushButton#meetingRosterStack { padding: 0; border: none; background: transparent; }
QPushButton#meetingRosterStack:hover { background: #eff7f5; border-radius: 12px; }
QDialog#meetingRosterPopup { background: #ffffff; border: 1px solid #dbe3ea; }
QLabel#meetingRosterTitle { color: #263c50; font-weight: 600; }
QWidget#meetingRosterPopupMembers { background: #ffffff; }
QScrollArea#meetingRosterScroll, QScrollArea#meetingRosterScroll > QWidget, QWidget#meetingMemberStrip {
    background: transparent;
}
QLabel#meetingMemberCount { color: #263c50; font-weight: 600; padding-right: 8px; }
QLabel#meetingWaiting { color: #8191a1; font-size: 9pt; }
QFrame#meetingFooter QPushButton#shareButton { padding: 11px 22px; }
QFrame#meetingFooter QPushButton#shareButton:enabled {
    background: #168c87; color: #ffffff; border-color: #168c87;
}
QFrame#meetingFooter QPushButton#shareButton:hover { background: #117873; }
QDialog#meetingSettings { background: #f3f5f8; }
